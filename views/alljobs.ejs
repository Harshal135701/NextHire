<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find Jobs | NextHire</title>
    <link rel="stylesheet" href="/stylesheets/navbar.css">
    <link rel="stylesheet" href="/stylesheets/alljobs.css">
</head>

<body>
    <%- include("partials/navbar") %>

    <div class="jobs-page-wrapper">
        <!-- HEADER -->
        <header class="jobs-header">
            <div class="jobs-header-container">
                <span class="header-badge">Career Opportunities</span>
                <h1 class="header-title">Find Your Next <span class="gradient-text">Dream Role</span></h1>
                <p class="header-subtitle">Search and filter through verified openings from leading technology companies and high-growth startups.</p>

                <!-- FILTER BAR -->
                <div class="filter-card">
                    <form action="/jobs/alljobs" method="GET" class="filter-form">
                        <div class="filter-row-primary">
                            <!-- Keyword Input -->
                            <div class="input-wrap keyword-wrap">
                                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <input type="text" name="keyword" placeholder="Job title, skills, or company..." value="<%= keyword || '' %>">
                            </div>

                            <!-- Location Select -->
                            <div class="input-wrap select-wrap">
                                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                <select name="location">
                                    <option value="">All Locations</option>
                                    <option value="Mumbai" <%= location === "Mumbai" ? "selected" : "" %>>Mumbai</option>
                                    <option value="Nashik" <%= location === "Nashik" ? "selected" : "" %>>Nashik</option>
                                    <option value="Bangalore" <%= location === "Bangalore" ? "selected" : "" %>>Bangalore</option>
                                    <option value="Delhi" <%= location === "Delhi" ? "selected" : "" %>>Delhi / NCR</option>
                                    <option value="Pune" <%= location === "Pune" ? "selected" : "" %>>Pune</option>
                                    <option value="Hyderabad" <%= location === "Hyderabad" ? "selected" : "" %>>Hyderabad</option>
                                    <option value="Remote" <%= location === "Remote" ? "selected" : "" %>>Remote</option>
                                </select>
                            </div>

                            <!-- Job Type Select -->
                            <div class="input-wrap select-wrap">
                                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                                <select name="jobType">
                                    <option value="">All Job Types</option>
                                    <option value="Full-time" <%= jobType === "Full-time" ? "selected" : "" %>>Full-time</option>
                                    <option value="Part-time" <%= jobType === "Part-time" ? "selected" : "" %>>Part-time</option>
                                    <option value="Internship" <%= jobType === "Internship" ? "selected" : "" %>>Internship</option>
                                    <option value="Remote" <%= jobType === "Remote" ? "selected" : "" %>>Remote</option>
                                </select>
                            </div>
                        </div>

                        <div class="filter-row-secondary">
                            <!-- Experience Select -->
                            <div class="input-wrap select-wrap">
                                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                <select name="experienceLevel">
                                    <option value="">Any Experience</option>
                                    <option value="0" <%= experienceLevel === "0" ? "selected" : "" %>>Fresher (0 yrs)</option>
                                    <option value="1" <%= experienceLevel === "1" ? "selected" : "" %>>1+ Years</option>
                                    <option value="2" <%= experienceLevel === "2" ? "selected" : "" %>>2+ Years</option>
                                    <option value="3" <%= experienceLevel === "3" ? "selected" : "" %>>3+ Years</option>
                                </select>
                            </div>

                            <!-- Min Salary Input -->
                            <div class="input-wrap salary-wrap">
                                <span class="rupee-icon">₹</span>
                                <input type="number" name="salary" placeholder="Min Salary" value="<%= salary || '' %>">
                            </div>

                            <!-- Sort Select -->
                            <div class="input-wrap select-wrap">
                                <select name="sort">
                                    <option value="">Sort By</option>
                                    <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>Newest First</option>
                                    <option value="salary_high" <%= sort === 'salary_high' ? 'selected' : '' %>>Highest Salary</option>
                                    <option value="salary_low" <%= sort === 'salary_low' ? 'selected' : '' %>>Lowest Salary</option>
                                </select>
                            </div>

                            <input type="hidden" name="category" value="<%= category || '' %>">

                            <!-- Submit & Reset Buttons -->
                            <div class="filter-actions">
                                <button type="submit" class="btn-filter-submit">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    <span>Apply</span>
                                </button>
                                <a href="/jobs/alljobs" class="btn-filter-clear" title="Reset Filters">Clear</a>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- CATEGORY QUICK PILLS -->
                <div class="category-pills-bar">
                    <span class="pills-label">Categories:</span>
                    <a href="/jobs/alljobs" class="cat-pill <%= !category ? 'active' : '' %>">All Roles</a>
                    <a href="/jobs/alljobs?category=Frontend<%= location ? '&location=' + location : '' %>" class="cat-pill <%= category === 'Frontend' ? 'active' : '' %>">Frontend</a>
                    <a href="/jobs/alljobs?category=Backend<%= location ? '&location=' + location : '' %>" class="cat-pill <%= category === 'Backend' ? 'active' : '' %>">Backend</a>
                    <a href="/jobs/alljobs?category=Full+Stack<%= location ? '&location=' + location : '' %>" class="cat-pill <%= category === 'Full Stack' || category === 'FullStack' ? 'active' : '' %>">Full Stack</a>
                    <a href="/jobs/alljobs?category=Cloud<%= location ? '&location=' + location : '' %>" class="cat-pill <%= category === 'Cloud' ? 'active' : '' %>">Cloud & DevOps</a>
                    <a href="/jobs/alljobs?category=Data+Science<%= location ? '&location=' + location : '' %>" class="cat-pill <%= category === 'Data Science' ? 'active' : '' %>">Data Science</a>
                </div>
            </div>
        </header>

        <!-- MAIN JOBS CONTAINER -->
        <main class="jobs-main-container">
            <div class="results-meta-bar">
                <div class="meta-count">
                    <% if (jobs && jobs.length > 0) { %>
                        Showing <strong><%= jobs.length %></strong> open positions
                        <% if (keyword) { %> for "<em><%= keyword %></em>"<% } %>
                    <% } else { %>
                        0 positions found
                    <% } %>
                </div>
                <div class="page-indicator">
                    Page <%= currentPage %> of <%= totalPages %>
                </div>
            </div>

            <!-- JOBS LIST / GRID -->
            <div class="jobs-container">
                <% if (!jobs || jobs.length === 0) { %>
                    <div class="empty-state-card">
                        <div class="empty-icon-wrap">🔍</div>
                        <h2>No Matching Jobs Found</h2>
                        <p>We couldn't find any job posts matching your current search criteria. Try broadening your keywords or clearing some filters.</p>
                        <a href="/jobs/alljobs" class="btn-reset-filters">Clear All Filters</a>
                    </div>
                <% } else { %>
                    <% jobs.forEach(job => { %>
                        <div class="job-card">
                            <div class="job-card-header">
                                <div class="company-info-group">
                                    <div class="company-logo-avatar">
                                        <%= job.company ? job.company.charAt(0).toUpperCase() : 'C' %>
                                    </div>
                                    <div>
                                        <div class="company-name-tag">
                                            <span><%= job.company %></span>
                                            <span class="verified-check" title="Verified Employer">✓</span>
                                        </div>
                                        <h2 class="job-title">
                                            <a href="/jobs/<%= job._id %>"><%= job.title %></a>
                                        </h2>
                                        <div class="job-meta-row">
                                            <span class="meta-item">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                                <%= job.location %>
                                            </span>
                                            <span class="meta-dot">•</span>
                                            <span class="meta-item">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                                <%= job.experienceLevel %>+ yrs experience
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="header-badges">
                                    <span class="type-badge <%= job.jobType.toLowerCase().replace(/\s+/g, '-') %>">
                                        <%= job.jobType %>
                                    </span>
                                </div>
                            </div>

                            <p class="job-description-excerpt">
                                <%= job.description.length > 150 ? job.description.substring(0, 150) + '...' : job.description %>
                            </p>

                            <div class="job-tags-container">
                                <span class="tag-badge category">
                                    <%= job.category || 'Engineering' %>
                                </span>
                                <span class="tag-badge">
                                    Actively Hiring
                                </span>
                            </div>

                            <div class="job-card-footer">
                                <div class="salary-block">
                                    <span class="salary-value">₹<%= Number(job.salary).toLocaleString('en-IN') %></span>
                                    <span class="salary-cadence">/ year</span>
                                </div>

                                <div class="card-actions">
                                    <button
                                        class="bookmark-btn <%= bookmarkedJobs && bookmarkedJobs.some(id => id && id.toString() === job._id.toString()) ? 'saved' : '' %>"
                                        data-id="<%= job._id %>"
                                        title="Bookmark this job"
                                        type="button">
                                        <svg class="bookmark-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path></svg>
                                        <span class="bookmark-text">
                                            <%= bookmarkedJobs && bookmarkedJobs.some(id => id && id.toString() === job._id.toString()) ? "Saved" : "Save Job" %>
                                        </span>
                                    </button>

                                    <a href="/jobs/<%= job._id %>" class="details-btn">
                                        <span>View Details</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <!-- PAGINATION -->
            <% if (totalPages > 1) { %>
                <div class="pagination">
                    <% if (currentPage > 1) { %>
                        <a href="/jobs/alljobs?page=<%= currentPage - 1 %>&keyword=<%= keyword || '' %>&category=<%= category || '' %>&location=<%= location || '' %>&salary=<%= salary || '' %>&jobType=<%= jobType || '' %>&experienceLevel=<%= experienceLevel || '' %>&sort=<%= sort || '' %>" class="page-link prev">
                            ← Previous
                        </a>
                    <% } else { %>
                        <span class="page-link disabled">← Previous</span>
                    <% } %>

                    <div class="page-numbers">
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <% if (i === currentPage) { %>
                                <span class="page-num active"><%= i %></span>
                            <% } else { %>
                                <a href="/jobs/alljobs?page=<%= i %>&keyword=<%= keyword || '' %>&category=<%= category || '' %>&location=<%= location || '' %>&salary=<%= salary || '' %>&jobType=<%= jobType || '' %>&experienceLevel=<%= experienceLevel || '' %>&sort=<%= sort || '' %>" class="page-num">
                                    <%= i %>
                                </a>
                            <% } %>
                        <% } %>
                    </div>

                    <% if (currentPage < totalPages) { %>
                        <a href="/jobs/alljobs?page=<%= currentPage + 1 %>&keyword=<%= keyword || '' %>&category=<%= category || '' %>&location=<%= location || '' %>&salary=<%= salary || '' %>&jobType=<%= jobType || '' %>&experienceLevel=<%= experienceLevel || '' %>&sort=<%= sort || '' %>" class="page-link next">
                            Next →
                        </a>
                    <% } else { %>
                        <span class="page-link disabled">Next →</span>
                    <% } %>
                </div>
            <% } %>
        </main>
    </div>

    <script src="/javascripts/alljobs.js"></script>
</body>

</html>
