<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile | NextHire</title>
    <link rel="stylesheet" href="/stylesheets/navbar.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
</head>

<body>
    <%- include("partials/navbar") %>

    <div class="profile-page-wrapper">
        <div class="profile-container">
            <!-- PROFILE COVER BANNER -->
            <div class="profile-cover-banner">
                <div class="cover-gradient"></div>
            </div>

            <!-- PROFILE CARD -->
            <div class="profile-card">
                <!-- AVATAR & HEADER -->
                <div class="profile-card-header">
                    <div class="avatar-wrapper">
                        <img src="<%= user.profilepic || '/images/default.webp' %>" alt="<%= user.fullname %>" class="user-avatar-image" id="avatarPreview">
                        <span class="role-pill-badge <%= user.role %>"><%= user.role %></span>
                    </div>

                    <div class="user-primary-meta">
                        <h1 class="user-display-name"><%= user.fullname %></h1>
                        <p class="user-display-occupation"><%= user.occupation || (user.role === 'recruiter' ? 'Talent Recruiter' : 'Seeking Opportunities') %></p>
                        <div class="user-tags-row">
                            <span class="meta-tag">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                <%= user.email %>
                            </span>
                            <span class="meta-tag">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                <%= user.experience || 0 %> Years Experience
                            </span>
                        </div>
                    </div>
                </div>

                <div class="profile-divider"></div>

                <!-- UPDATE PROFILE FORM -->
                <form id="updateProfile" enctype="multipart/form-data" class="profile-form">
                    <div class="form-section-title">
                        <h2>Personal & Professional Information</h2>
                        <p>Update your details so recruiters and employers can match you with appropriate roles.</p>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="fullname">Full Name</label>
                            <input
                                type="text"
                                id="fullname"
                                name="fullname"
                                value="<%= user.fullname || '' %>"
                                placeholder="Enter your full name"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="occupation">Occupation / Current Title</label>
                            <input
                                type="text"
                                id="occupation"
                                name="occupation"
                                value="<%= user.occupation || '' %>"
                                placeholder="e.g. Senior Frontend Engineer"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="experience">Experience (Years)</label>
                            <input
                                type="number"
                                id="experience"
                                name="experience"
                                value="<%= user.experience !== undefined ? user.experience : 0 %>"
                                placeholder="Years of professional experience"
                                min="0"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label>Email Address</label>
                            <input
                                type="email"
                                value="<%= user.email %>"
                                disabled
                                class="disabled-input"
                                title="Email address cannot be changed"
                            >
                            <span class="field-hint">Primary account identifier (Read-only)</span>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Profile Picture</label>
                        <div class="file-picker-card">
                            <div class="file-picker-icon">📸</div>
                            <div class="file-picker-text">
                                <strong>Upload a new photo</strong>
                                <span>PNG, JPG, or WEBP up to 5MB</span>
                            </div>
                            <input
                                type="file"
                                name="profilepic"
                                id="profilepicInput"
                                accept="image/*"
                                class="file-input"
                            >
                        </div>
                    </div>

                    <div class="form-actions-bar">
                        <a href="/home" class="btn-cancel">Cancel</a>
                        <button type="submit" class="update-btn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Save Changes</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/javascripts/updateProfile.js"></script>
    <script>
        const profilepicInput = document.getElementById('profilepicInput');
        const avatarPreview = document.getElementById('avatarPreview');
        if (profilepicInput && avatarPreview) {
            profilepicInput.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        avatarPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
        }
    </script>
</body>

</html>
