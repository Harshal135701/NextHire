<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recruiter Dashboard | NextHire</title>
    <link rel="stylesheet" href="/stylesheets/navbar.css">
    <link rel="stylesheet" href="/stylesheets/recruiterHome.css">
</head>

<body>
    <%- include('partials/navbar') %>

    <div class="recruiter-page-wrapper">
        <div class="recruiter-container">
            <!-- DASHBOARD HERO BANNER -->
            <div class="recruiter-banner">
                <div class="banner-text">
                    <span class="banner-eyebrow">Hiring Command Center</span>
                    <h1 class="banner-title">Welcome back, <%= user.fullname || 'Recruiter' %></h1>
                    <p class="banner-subtitle">Manage open positions, review candidate resumes, and track applicant stages in one centralized dashboard.</p>
                </div>
                <div class="banner-actions">
                    <a href="/recruiter/create" class="btn-create-job">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Post New Job</span>
                    </a>
                </div>
            </div>

            <!-- KPI STATS SECTION -->
            <div class="stats-grid">
                <div class="stat-card blue">
                    <div class="stat-icon-wrap">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Total Jobs Posted</span>
                        <div class="stat-number"><%= jobs ? jobs.length : 0 %></div>
                    </div>
                </div>

                <div class="stat-card purple">
                    <div class="stat-icon-wrap">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Total Applicants</span>
                        <div class="stat-number"><%= applicants || 0 %></div>
                    </div>
                </div>

                <div class="stat-card amber">
                    <div class="stat-icon-wrap">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Pending Review</span>
                        <div class="stat-number"><%= pending || 0 %></div>
                    </div>
                </div>

                <div class="stat-card indigo">
                    <div class="stat-icon-wrap">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Shortlisted</span>
                        <div class="stat-number"><%= shortlisted || 0 %></div>
                    </div>
                </div>

                <div class="stat-card emerald">
                    <div class="stat-icon-wrap">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Accepted</span>
                        <div class="stat-number"><%= accepted || 0 %></div>
                    </div>
                </div>

                <div class="stat-card rose">
                    <div class="stat-icon-wrap">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Rejected</span>
                        <div class="stat-number"><%= rejected || 0 %></div>
                    </div>
                </div>
            </div>

            <!-- PUBLISHED JOBS MANAGEMENT TABLE -->
            <div class="table-card">
                <div class="table-card-header">
                    <div>
                        <h2>Published Job Listings</h2>
                        <p>Track candidate volume and manage job postings.</p>
                    </div>
                    <a href="/recruiter/myjobs" class="view-all-link">
                        <span>View Grid View</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>

                <% if (!jobs || jobs.length === 0) { %>
                    <div class="empty-jobs-card">
                        <div class="empty-icon">📢</div>
                        <h3>No Job Posts Created Yet</h3>
                        <p>Start sourcing top talent by publishing your first job listing with our AI description generator.</p>
                        <a href="/recruiter/create" class="btn-post-first">Create Your First Job</a>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="jobs-table">
                            <thead>
                                <tr>
                                    <th>Job Title</th>
                                    <th>Location</th>
                                    <th>Applicants</th>
                                    <th>Status</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% jobs.forEach(function(job){ %>
                                    <tr>
                                        <td>
                                            <div class="job-cell-title">
                                                <a href="/recruiter/<%= job._id %>/applications" class="job-link">
                                                    <%= job.title %>
                                                </a>
                                                <span class="cell-sub"><%= job.company || '' %></span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="cell-location">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                                <%= job.location || "N/A" %>
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/recruiter/<%= job._id %>/applications" class="applicant-count-pill" title="View Applicants">
                                                <span><%= job.applicationCount !== undefined ? job.applicationCount : 0 %> Candidates</span>
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                            </a>
                                        </td>
                                        <td>
                                            <span class="status-active-pill">
                                                <span class="status-dot"></span>
                                                Active
                                            </span>
                                        </td>
                                        <td>
                                            <div class="action-buttons-group">
                                                <a href="/recruiter/<%= job._id %>/applications" class="btn-action applicants" title="View Applicants">
                                                    Applicants
                                                </a>
                                                <a href="/recruiter/<%= job._id %>/update" class="btn-action edit" title="Edit Job">
                                                    Edit
                                                </a>
                                                <button class="btn-action delete deleteBtn" data-job-id="<%= job._id %>" title="Delete Job" type="button">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="/javascripts/deletePost.js"></script>
</body>

</html>
