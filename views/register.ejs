<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Your NextHire Account</title>
    <link rel="stylesheet" href="/stylesheets/register.css">
</head>

<body>
    <div class="auth-layout">
        <!-- LEFT BRAND PANEL -->
        <aside class="auth-brand-panel">
            <div class="panel-content">
                <a href="/login" class="panel-logo">
                    <span class="logo-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="20" height="14" x="2" y="7" rx="3"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    </span>
                    Next<span>Hire</span>
                </a>

                <div class="panel-hero">
                    <span class="panel-badge">Join NextHire</span>
                    <h2>Build Your Professional Career or Hire Top Talent</h2>
                    <p>Whether you're looking for your next high-impact role or recruiting world-class engineers, NextHire delivers intelligent hiring tools built for tech.</p>
                </div>

                <div class="role-highlights-grid">
                    <div class="role-box">
                        <div class="role-box-icon">🚀</div>
                        <h4>For Candidates</h4>
                        <p>Search 12,000+ verified openings, match your resume using AI, and chat directly with recruiters.</p>
                    </div>

                    <div class="role-box">
                        <div class="role-box-icon">💼</div>
                        <h4>For Recruiters</h4>
                        <p>Publish job posts with AI descriptions, review applicant pipelines, and manage offers seamlessly.</p>
                    </div>
                </div>

                <div class="panel-footer-stat">
                    <span>Over <strong>850+</strong> Tech Companies Actively Hiring</span>
                </div>
            </div>
        </aside>

        <!-- RIGHT FORM PANEL -->
        <main class="auth-form-panel">
            <div class="form-wrapper">
                <div class="form-header">
                    <div class="mobile-logo">Next<span>Hire</span></div>
                    <h1>Create Your Account</h1>
                    <p>Get started in minutes and explore high-growth job opportunities.</p>
                </div>

                <% if (typeof message !== "undefined") { %>
                    <div class="alert-box error">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        <span><%= message %></span>
                    </div>
                <% } %>

                <form action="/register" method="post" enctype="multipart/form-data" class="auth-form">
                    <!-- ROLE SELECTION -->
                    <div class="form-group">
                        <label>Select Account Type</label>
                        <div class="role-select-cards">
                            <label class="role-card-option">
                                <input type="radio" name="role" value="candidate" checked>
                                <div class="role-card-inner">
                                    <span class="role-icon">👨‍💻</span>
                                    <div>
                                        <strong>Job Seeker</strong>
                                        <span>Find & apply to tech roles</span>
                                    </div>
                                </div>
                            </label>

                            <label class="role-card-option">
                                <input type="radio" name="role" value="recruiter">
                                <div class="role-card-inner">
                                    <span class="role-icon">🏢</span>
                                    <div>
                                        <strong>Recruiter</strong>
                                        <span>Post jobs & hire talent</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label for="fullname">Full Name</label>
                            <input type="text" id="fullname" name="fullname" placeholder="e.g. Alex Morgan" required autocomplete="name">
                        </div>

                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" placeholder="name@company.com" required autocomplete="email">
                        </div>
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" placeholder="Create a strong password" required autocomplete="new-password">
                        </div>

                        <div class="form-group">
                            <label for="occupation">Occupation / Current Title</label>
                            <input type="text" id="occupation" name="occupation" placeholder="e.g. Software Engineer" required>
                        </div>
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label for="experience">Experience (Years)</label>
                            <input type="number" id="experience" name="experience" placeholder="e.g. 2" min="0" required>
                        </div>

                        <div class="form-group">
                            <label for="profilepic">Profile Picture (Optional)</label>
                            <div class="file-picker-input-wrap">
                                <input type="file" id="profilepic" name="profilepic" accept="image/*">
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit-btn">
                        <span>Create Account</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                </form>

                <div class="auth-footer">
                    <p>Already have an account? <a href="/login" class="auth-link">Sign in here</a></p>
                </div>
            </div>
        </main>
    </div>
</body>

</html>
